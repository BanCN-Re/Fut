    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>false</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(ProjectDir);D:\obf\Themida\ThemidaSDK\Lib\COFF;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>crypt32.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;winmm.lib;ws2_32.lib;SecureEngineSDK64.lib;%(AdditionalDependencies)</AdditionalDependencies>
