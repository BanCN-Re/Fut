// D:\Work\Fut\cheat\src\version.rc
//
// P2: give the proxy the SAME version resource as the genuine zlibwapi.dll.
//
// WHY: the deployed file is named zlibwapi.dll and sits in the game's own
// directory where the real zlib normally lives. The original carries a full
// VERSIONINFO block; ours carried none. A file with no version information in
// that exact location is trivially distinguishable from the real library by any
// module-metadata check -- no memory scan required, just GetFileVersionInfo on
// the loaded image path.
//
// Values below are copied verbatim from the genuine 2026-09-22 zlibwapi.dll
// (zlibwapi_orig.dll, 133,936 B) so the metadata matches it:
//
//     FileVersion      : 1.2.11
//     FileDescription  : zlib data compression and ZIP file I/O library
//     InternalName     : zlib
//     LegalCopyright   : (C) 1995-2017 Jean-loup Gailly & Mark Adler
//     OriginalFilename : zlibwapi.dll
//     ProductName      : ZLib.DLL
//     Comments         : DLL support by Alessandro Iacopetti & Gilles Vollant
//
// NOTE: this file is compiled by rc.exe and must therefore avoid non-ASCII and
// C++ syntax. Keep it plain resource script.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,2,11,0
 PRODUCTVERSION  1,2,11,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments",         "DLL support by Alessandro Iacopetti & Gilles Vollant\0"
            VALUE "FileDescription",  "zlib data compression and ZIP file I/O library\0"
            VALUE "FileVersion",      "1.2.11\0"
            VALUE "InternalName",     "zlib\0"
            VALUE "LegalCopyright",   "(C) 1995-2017 Jean-loup Gailly & Mark Adler\0"
            VALUE "OriginalFilename", "zlibwapi.dll\0"
            VALUE "ProductName",      "ZLib.DLL\0"
            VALUE "ProductVersion",   "1.2.11\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
